# Database (Docker Compose service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=notes_db

# Where the API container finds the DB
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Where pytest on the host finds the test DB
TEST_POSTGRES_HOST=localhost
TEST_POSTGRES_PORT=5433
TEST_POSTGRES_DB=notes_test

# JWT signing key — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-string

# Connection pool
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2

REDIS_URL=redis://redis:6379/0