# Database — values here are used by Python on the HOST (pytest, uvicorn on Windows).
# Containers override POSTGRES_HOST/POSTGRES_PORT via docker-compose.yml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=notes_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Test DB — same server, different database
TEST_POSTGRES_HOST=localhost
TEST_POSTGRES_PORT=5433
TEST_POSTGRES_DB=notes_test

# JWT signing key — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-string

# Connection pool
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2

# Redis — host-side Python uses localhost; containers override via compose.
REDIS_URL=redis://localhost:6379/0